# =====================================================================
# NEQST — variáveis de ambiente do backend
#
# Copie para .env  (git-ignorado) e preencha o que estiver em branco.
#
# A SUPABASE_ANON_KEY já vem preenchida: é a chave *publicável*, feita
# para viajar dentro do app mobile, e só dá acesso ao que as policies de
# RLS permitem. Todas as demais são segredo e ficam em branco aqui — DoD
# da Sprint 1: "Variáveis sensíveis (chaves de API, tokens) fora do
# código-fonte".
# =====================================================================

# ---------------------------------------------------------------------
# Projeto Supabase
# ---------------------------------------------------------------------
SUPABASE_URL=https://iqspcnjjmkzkhulrefpa.supabase.co
SUPABASE_PROJECT_REF=iqspcnjjmkzkhulrefpa

# Chave publicável (Dashboard > Settings > API > anon public).
# Vai no app mobile e no repositório: sozinha, ela não dá acesso a nada
# além do que as policies de RLS liberam — por isso toda tabela tem RLS
# ativo e a fila só aceita escrita via RPC (ver docs/database.md).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imlxc3BjbmpqbWt6a2h1bHJlZnBhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAxNTk4MzcsImV4cCI6MjEwNTczNTgzN30.rjIkvfYuo48tZLK5f9E2Acr6KK2LLj0sW1Ey2vt99Y8

# Chave privada (Dashboard > Settings > API > service_role).
# SOMENTE servidor/Edge Functions. Ignora RLS por completo — jamais no
# app, jamais no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta (migrations via CLI / psql).
DATABASE_URL=postgresql://postgres:[SENHA]@db.iqspcnjjmkzkhulrefpa.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Assinatura dos QR Codes (US-02)
# Gere com:  openssl rand -base64 48
# Trocar este valor invalida TODOS os QR Codes impressos.
# ---------------------------------------------------------------------
QR_SIGNING_SECRET=

# ---------------------------------------------------------------------
# Worker de notificações
# ---------------------------------------------------------------------
# Protege a rota dispatch-notifications:  openssl rand -hex 32
CRON_SECRET=

# Opcional: Expo access token (necessário só se o projeto Expo exigir
# push security). Expo Dashboard > Account Settings > Access Tokens.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# SSO (US-01 — obrigatório para App Store / Play Store)
# Configurar em Dashboard > Authentication > Providers
# ---------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
