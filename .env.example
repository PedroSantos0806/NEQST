# =====================================================================
# NEQST — variáveis de ambiente do backend
#
# Copie para .env  (git-ignorado) e preencha.
# NUNCA comite chaves reais — DoD da Sprint 1:
# "Variáveis sensíveis (chaves de API, tokens) fora do código-fonte".
# =====================================================================

# ---------------------------------------------------------------------
# Projeto Supabase
# ---------------------------------------------------------------------
SUPABASE_URL=https://iqspcnjjmkzkhulrefpa.supabase.co
SUPABASE_PROJECT_REF=iqspcnjjmkzkhulrefpa

# Chave pública (Dashboard > Settings > API > anon public).
# Pode ir no app mobile: só funciona junto com as policies de RLS.
SUPABASE_ANON_KEY=

# Chave privada (Dashboard > Settings > API > service_role).
# SOMENTE servidor/Edge Functions. Ignora RLS — jamais no app ou no repo.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta (migrations via CLI / psql).
DATABASE_URL=postgresql://postgres:[SENHA]@db.iqspcnjjmkzkhulrefpa.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Assinatura dos QR Codes (US-02)
# Gere com:  openssl rand -base64 48
# Trocar este valor invalida TODOS os QR Codes impressos.
# ---------------------------------------------------------------------
QR_SIGNING_SECRET=

# ---------------------------------------------------------------------
# Worker de notificações
# ---------------------------------------------------------------------
# Protege a rota dispatch-notifications:  openssl rand -hex 32
CRON_SECRET=

# Opcional: Expo access token (necessário só se o projeto Expo exigir
# push security). Expo Dashboard > Account Settings > Access Tokens.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------
# SSO (US-01 — obrigatório para App Store / Play Store)
# Configurar em Dashboard > Authentication > Providers
# ---------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
