# Variáveis do app web (Vercel > Settings > Environment Variables).
# Só chaves públicas: nada de service_role aqui — ela ignora o RLS e
# qualquer pessoa consegue lê-la no bundle do navegador.

VITE_SUPABASE_URL=https://iqspcnjjmkzkhulrefpa.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: sem ela o app busca a chave no backend ao ligar as
# notificações. Defini-la aqui poupa uma chamada.
VITE_VAPID_PUBLIC_KEY=

# Opcional: link do app na Play Store. Aparece para quem chega pelo QR na
# tela de alguém da fila (quadras do piloto). Sem ele, o convite oferece
# só instalar o site no celular.
VITE_PLAY_STORE_URL=
